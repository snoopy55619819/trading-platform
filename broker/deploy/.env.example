# Copy to .env (never committed). Passwords: letters and digits only, since they go into
# connection URLs:  openssl rand -hex 24
BROKER_DB_PASSWORD=
MARKET_DATA_DB_PASSWORD=

# Production:
#   SITE_ADDRESS=tradeplatform.dev          Caddy gets the certificate for this name
#   SITE_ORIGIN=https://tradeplatform.dev
# Locally, plain HTTP on port 8000:
#   SITE_ADDRESS=:80
#   SITE_ORIGIN=http://localhost:8000
#   HTTP_PORT=8000
#   HTTPS_PORT=8443
SITE_ADDRESS=
SITE_ORIGIN=

# Where images come from: ghcr.io/snoopy55619819/trading-platform in production. Locally
# the defaults build and tag them as local/...:latest.
# IMAGE_PREFIX=
# TAG=
