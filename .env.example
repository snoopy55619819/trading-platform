# Local development only. Copy to .env.
# Deployed environments provide these through the environment itself; the scripts
# read a .env only when PGHOST and DATABASE_URL are both unset.
#
# Each company has its own database and its own role. No role has any grant on
# another company's database.

# broker
DATABASE_URL=postgres://broker:broker@127.0.0.1:5432/broker

# exchange-alpha — added at milestone 2
# EXCHANGE_DATABASE_URL=postgres://exchange_alpha:exchange_alpha@127.0.0.1:5433/exchange_alpha
