{
  "name": "broker-market-data",
  "private": true,
  "type": "module",
  "description": "Market data service: subscribes to the venue feed, fans out live prices, stores ticks, serves chart history.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "proto:gen": "buf generate",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2"
  }
}
