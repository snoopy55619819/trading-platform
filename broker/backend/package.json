{
  "name": "broker-backend",
  "private": true,
  "type": "module",
  "description": "The broker application: api + oms + ledger + FIX initiator, one process, one transaction.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:seed": "node scripts/seed-securities.mjs",
    "db:check": "node scripts/seed-securities.mjs --check",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.2"
  }
}
