{
  "name": "market-simulator",
  "private": true,
  "type": "module",
  "description": "Simulated third-party trading firms. Connects to Alpha Exchange over the same public FIX session and market data feed any client uses - no backdoor.",
  "engines": { "node": ">=26" },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "proto:gen": "buf generate",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
